# ==============================================================================
# Argus - Variáveis de Ambiente (.env.example)
# Copie este ficheiro para .env e ajuste os valores conforme o seu ambiente.
# ==============================================================================

# Django
DJANGO_SECRET_KEY=argus-insecure-dev-key-change-in-production-2026-modsi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de Dados MySQL 8
DB_NAME=argus_db
DB_USER=argus_user
DB_PASSWORD=argus_pass
DB_HOST=127.0.0.1
DB_PORT=3306

# MySQL Root (utilizado para inicialização do container Docker/Podman)
MYSQL_ROOT_PASSWORD=rootpassword

# Caminho de Armazenamento Local de Ficheiros (relativo ou absoluto)
STORAGE_DIR=../storage

# Segurança & CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
